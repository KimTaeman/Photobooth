{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimum local IPC permissions for the photobooth upload queue",
  "local": true,
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:path:allow-join",
    "fs:deny-default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPCACHE/queue_metadata.json" }, { "path": "$APPCACHE/upload_queue" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCACHE/upload_queue" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPCACHE/queue_metadata.json" },
        { "path": "$APPCACHE/queue_metadata.tmp" },
        { "path": "$APPCACHE/upload_queue/*" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$APPCACHE/queue_metadata.tmp" },
        { "path": "$APPCACHE/queue_metadata.json" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPCACHE/upload_queue" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$APPCACHE/upload_queue/*" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPCACHE/queue_metadata.json" }, { "path": "$APPCACHE/upload_queue/*" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPCACHE/upload_queue/*" }]
    }
  ]
}
